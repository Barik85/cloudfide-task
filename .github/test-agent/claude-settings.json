{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit(./backend/tests/**)",
      "Edit(./frontend/src/**/*.test.ts)",
      "Edit(./frontend/src/**/*.test.tsx)",
      "Edit(./frontend/src/test/**)",
      "Bash(bash .github/test-agent/scripts/run-tests.sh:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(~/.claude/**)",
      "Read(~/.config/**)",
      "Read(./.git/config)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.git/**)",
      "Edit(**/package.json)",
      "Edit(**/package-lock.json)",
      "Edit(**/vite.config.ts)",
      "Edit(**/vitest.config.ts)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "cleanupPeriodDays": 1,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Glob|Grep|WebFetch|WebSearch|Task|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.github/test-agent/scripts/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
